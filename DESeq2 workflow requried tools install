files <- list.files(path = data_folder, pattern = "_featurecounts\\.csv$", full.names = TRUE)

# Function to read and keep only Geneid + counts column
read_counts <- function(file) {
  df <- read.csv(file)
  df <- df[, c("Geneid", colnames(df)[ncol(df)])]
  colnames(df)[2] <- tools::file_path_sans_ext(basename(file))
  return(df)
}

# Read all files into a list
df_list <- lapply(files, read_counts)

# Merge all dataframes by Geneid using purrr::reduce
