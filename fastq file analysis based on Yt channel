# Quality control of fastq file 

## firstly change the user from root
sudo chown $USER:$USER /mnt/d/Thesis/demo/demo.fastq


##code for quality control
fastqc /mnt/d/Thesis/demo/demo.fastq

#Trim the data
trimmomatic SE -threads 4 \
/mnt/d/Thesis/demo/demo.fastq \
/mnt/d/Thesis/demo/demo_trimmed.fastq \
TRAILING:10 \
-phred33

fastqc /mnt/d/Thesis/demo/demo_trimmed.fastq -o /mnt/d/Thesis/demo/

#Align reads : HISAT2
##Download hisat2 gene files
wget https://genome-idx.s3.amazonaws.com/hisat/grch38_genome.tar.gz
##Extract it
tar -xvzf grch38_genome.tar.gz

##then command
hisat2 -q --rna-strandness R \
-x /mnt/d/Thesis/HISAT2/grch38/GRCh38.genome \
-U /mnt/d/Thesis/demo/demo_trimmed.fastq | \
samtools sort -o /mnt/d/Thesis/HISAT2/demo_trimmed.bam


#get featureCounts data
featureCounts -S 2 \
  -a /mnt/d/Thesis/hg38/Homo_sapiens.GRCh38.106.gtf \
  -o /mnt/d/Thesis/demo/joy_new/ERR9134329_featurecounts.txt \
  /mnt/d/Thesis/demo/joy_new/demo_aligned.bam
